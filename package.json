{
  "name": "@smykla-skalski/sui",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "description": "Themeable Svelte UI primitives for Smykla projects",
  "keywords": [
    "svelte",
    "svelte5",
    "components",
    "design-system"
  ],
  "homepage": "https://github.com/smykla-skalski/sui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smykla-skalski/sui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "./.svelte-kit/generated/**/env/service-worker.js"
  ],
  "files": [
    "dist",
    "docs"
  ],
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./service-worker": {
      "types": "./dist/service-worker/index.d.ts",
      "default": "./dist/service-worker/index.js"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package",
    "build:site": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "test:browser": "node --test --test-concurrency=1 --test-global-setup=tests/browser/setup.mjs tests/browser/*.test.mjs && node --test --test-concurrency=1 --test-global-setup=tests/browser/setup.mjs tests/browser/timing/*.test.mjs",
    "test:browser:long": "SUI_LONG=1 npm run test:browser",
    "test:browser:ci": "node tests/browser/run.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.14.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.25",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
