{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":gitSignOff",
    ":dependencyDashboard",
    ":label(dependencies)",
    ":rebaseStalePrs",
    ":enableVulnerabilityAlertsWithAdditionalLabel(kind/security)",
    ":prConcurrentLimit20",
    "helpers:pinGitHubActionDigests",
    "security:openssf-scorecard",
    "group:linters"
  ],
  "ignorePaths": [
    "**/tmp/**",
    ".github/workflows/smyklot-pr-commands.yml",
    ".github/workflows/smyklot-poll.yml"
  ],
  "osvVulnerabilityAlerts": true,
  "gitIgnoredAuthors": ["205507218+smyklot[bot]@users.noreply.github.com"],
  "internalChecksFilter": "strict",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "packageRules": [
    {
      "description": "Automerge updates with a verified release age of at least seven days",
      "matchUpdateTypes": ["major", "minor", "patch", "digest"],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "addLabels": ["area/ci"],
      "commitMessageTopic": "{{depName}} action",
      "description": "GitHub Actions dependencies",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Group Go tool dependencies",
      "groupName": "Go tooling",
      "matchDepTypes": ["require"],
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^golang.org/x/tools/"]
    },
    {
      "description": [
        " Group dependency bumps from selected GitHub sources into a single PR across managers",
        " (e.g., mise and gomod) to avoid separate PRs per manager"
      ],
      "matchSourceUrls": ["https://github.com/{onsi/ginkgo,golangci/golangci-lint}"],
      "groupName": "{{{replace 'https://github\\.com/[a-z-]+/' '' sourceUrl}}}"
    },
    {
      "description": "Group Go version updates from gomod and mise into a single PR",
      "groupName": "go version",
      "matchDepNames": ["go"],
      "matchManagers": ["gomod", "mise"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Smyklot action managed by sync-smyklot workflow",
      "enabled": false,
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["smykla-skalski/smyklot"]
    },
    {
      "allowedVersions": "<7",
      "description": "svelte-check and svelte-package need the TypeScript 6 JS API; TypeScript 7 runs as @typescript/native",
      "matchPackageNames": ["typescript"]
    },
    {
      "allowedVersions": ">=24 <25",
      "description": "Keep Node types aligned with the Node 24 LTS runtime",
      "matchPackageNames": ["@types/node"]
    },
    {
      "description": "The visual group runs in the Playwright image whose browsers playwright-core expects, so both move together",
      "groupName": "playwright",
      "matchPackageNames": ["playwright-core", "mcr.microsoft.com/playwright"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Playwright image of the visual group in CI and of its recording task",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/", "/^\\.mise\\.toml$/"],
      "matchStrings": [
        "(?<depName>mcr\\.microsoft\\.com/playwright):(?<currentValue>v[0-9.]+-noble)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "vulnerabilityAlerts": {
    "automerge": false
  }
}
